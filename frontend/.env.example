# Frontend Environment Variables
# Copy this to .env locally; on Vercel add the same keys under Project Settings → Environment Variables.

# Backend API URL (must include /api). Production example:
# VITE_API_URL=https://your-render-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID (Web application). Must match backend GOOGLE_CLIENT_ID exactly.
# Create in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
