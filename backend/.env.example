# Copy to `.env` and fill in values. Never commit real secrets.

# --- Razorpay (Test mode for demos: Dashboard → Test mode → API keys) ---
# Without these, only mock checkout works (if DUMMY_PAYMENT=true).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Optional: webhook signing secret if you use Razorpay webhooks
# RAZORPAY_WEBHOOK_SECRET=

# --- Dual checkout: Razorpay + in-app “Test pay (mock)” ---
# Set to true so learners see BOTH:
#   • “Pay with Razorpay” → real Razorpay Test/Live checkout
#   • “Test pay (mock)” → no gateway; completes via dummy-verify (good when Test checkout blocks you)
# Set to false for Razorpay-only (production).
DUMMY_PAYMENT=true

# --- Core ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/plp
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated origins, e.g. https://app.vercel.app,https://preview.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=false

# FAILED_PAYMENT_RETENTION_HOURS=72

# --- Google AI (Gemini) ---
# GEMINI_API_KEY=

# --- Optional: S3-compatible storage for course uploads (recommended on Render / ephemeral disks) ---
# When all of the first four are set, uploaded materials are sent to the bucket and DB stores the public URL.
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional: Cloudflare R2 / MinIO / LocalStack
# AWS_S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
# Optional: public base URL (CDN or R2 public URL) — used for object URLs and delete key parsing
# AWS_S3_PUBLIC_URL_BASE=https://pub-xxxx.r2.dev
